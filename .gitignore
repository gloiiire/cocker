# iCloud Drive placeholder files (the daemon dir uses them for downloads).
.fl*

# Root-level initrd.img is a stray leftover from manual repacking
# experiments — the real one lives at cocker-init/initrd.img and is
# the only copy any code reads.
/initrd.img

# iCloud Drive conflict copies (files renamed "foo 2.ext" when the
# daemon's sync sees two versions). They're identical to the originals
# 99 % of the time but they break Swift builds (duplicate type decls).
*\ 2.swift
*\ 2.c
*\ 2.rb
