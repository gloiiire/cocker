.build/
.build.nosync/
*.o
*.d
.swiftpm/
xcuserdata/
DerivedData/
*.xcworkspace
.DS_Store
*.tar
*.gz

# iCloud Drive placeholder files (the daemon dir uses them for downloads).
.fl*

# Root-level initrd.img is a stray leftover from manual repacking
# experiments — the real one lives at cocker-init/initrd.img and is
# the only copy any code reads.
/initrd.img

# iCloud Drive conflict copies (files renamed "foo 2.ext" when the
# daemon's sync sees two versions). They're identical to the originals
# 99 % of the time but they break Swift builds (duplicate type decls)
# and pollute Tests/e2e/ with phantom test scripts.
*\ 2.swift
*\ 2.c
*\ 2.rb
*\ 2.sh
*\ 2.md
*\ 2.yml
*\ 2.yaml
*\ 2.json

# Local release bundle staging — the only canonical artifacts ship
# through gh release / homebrew tap.
/dist/

# Markdown — only README files travel in the repo. CHANGELOG, docs/,
# CLAUDE.md, .roadmap.md, RELEASE.md, QUICKSTART.md and any iCloud
# "*2.md" sync duplicates stay out of git.
*.md
!README.md
!**/README.md
# Exceptions : long-lived spec docs that the codebase points to.
!docs/UX-CHARTER.md
!docs/APPLE-FEEDBACK-VSOCK-CALLBACK.md
!docs/ROADMAP-1.0.md
# A 1.0 needs a changelog a user can read to decide whether to upgrade, and a
# security file — cocker installs a root LaunchDaemon and stores registry
# passwords in cleartext, and neither is discoverable from the README.
!CHANGELOG.md
!SECURITY.md
node_modules/
package.json
package-lock.json
